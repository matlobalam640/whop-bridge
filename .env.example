# Server
PORT=3000

# Your public bridge base URL (no trailing slash)
# Used for health checks and docs — set this after you deploy.
# Example: https://pay.yourdomain.com
BRIDGE_BASE_URL=https://pay.yourdomain.com

# Whop (Dashboard → Developer)
WHOP_API_KEY=your_whop_api_key
WHOP_COMPANY_ID=biz_xxxxxxxxxxxxxx
WHOP_WEBHOOK_SECRET=your_webhook_secret

# Optional: use an existing Whop plan instead of creating one per order
# WHOP_PLAN_ID=plan_xxxxxxxxxxxxxx

# WooCommerce REST API (WooCommerce → Settings → Advanced → REST API)
WOOCOMMERCE_URL=https://yourstore.com
WC_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Query auth is ON by default (best for Hostinger + Vercel). Set false to use HTTP Basic only:
# WC_USE_QUERY_AUTH=false

# Where customers return after paying on Whop
WC_ORDER_RECEIVED_URL=https://yourstore.com/checkout/order-received/

# Allow test order IDs that do not exist in WooCommerce (set false in production)
WHOP_ALLOW_FAKE_ORDER_ID=false
